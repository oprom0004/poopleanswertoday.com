---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Privacy Policy: Poople Answer Today';
const pageDescription = 'Privacy Policy for poopleanswertoday.com. Information on cookies, advertising partners, and privacy rights.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <h1 class="text-3xl font-black text-ink">Privacy Policy</h1>
    <div class="bg-white border-2 border-paper-border rounded-2xl p-6 sm:p-10 shadow-warm-md space-y-6 text-sm leading-relaxed text-ink">
      <p>Last updated: October 2, 2026</p>
      
      <h2 class="text-lg font-bold text-ink">1. Overview</h2>
      <p>Your privacy is important to us. At <strong>poopleanswertoday.com</strong>, we do not require user accounts or collect personally identifiable information directly.</p>

      <h2 class="text-lg font-bold text-ink">2. Log Files & Analytics</h2>
      <p>Like many standard websites, we use basic server logging and anonymous analytics (e.g. Cloudflare Analytics) to understand aggregated traffic patterns, device types, and browser versions.</p>

      <h2 class="text-lg font-bold text-ink">3. Advertising and Cookies (Google AdSense)</h2>
      <p>We may partner with third-party advertising networks such as Google AdSense. Third-party vendors use cookies to serve ads based on a user's prior visits to this or other websites. Users may opt out of personalized advertising by visiting Google Ads Settings.</p>

      <h2 class="text-lg font-bold text-ink">4. Contact Us</h2>
      <p>If you have any questions regarding this Privacy Policy, please contact us via our site channels.</p>
    </div>
  </div>
</Layout>
