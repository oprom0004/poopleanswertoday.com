---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Terms of Service: Poople Answer Today';
const pageDescription = 'Terms of Service for poopleanswertoday.com.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <h1 class="text-3xl font-black text-ink">Terms of Service</h1>
    <div class="bg-white border-2 border-paper-border rounded-2xl p-6 sm:p-10 shadow-warm-md space-y-6 text-sm leading-relaxed text-ink">
      <h2 class="text-lg font-bold text-ink">1. Acceptance of Terms</h2>
      <p>By accessing and using <strong>poopleanswertoday.com</strong>, you agree to comply with and be bound by these Terms of Service.</p>

      <h2 class="text-lg font-bold text-ink">2. Permitted Use</h2>
      <p>This service is provided for personal, non-commercial entertainment and educational purposes.</p>

      <h2 class="text-lg font-bold text-ink">3. Intellectual Property</h2>
      <p>All trademarks and copyrights related to the Poople game belong to their respective owners. Poople Answer Today is an independent fan resource.</p>
    </div>
  </div>
</Layout>
